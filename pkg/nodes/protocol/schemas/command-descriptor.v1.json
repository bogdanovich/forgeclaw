{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mintclaw.dev/schemas/nodes/command-descriptor.v1.json",
  "title": "MintClaw node command descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "input_schema", "output_schema", "risk"],
  "properties": {
    "name": {"type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*\\.v[1-9][0-9]*$"},
    "input_schema": {"type": "object"},
    "output_schema": {"type": "object"},
    "risk": {"enum": ["read", "write", "privileged"]},
    "supports_progress": {"type": "boolean"},
    "supports_cancel": {"type": "boolean"},
    "model_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "timeout_seconds_max",
        "output_bytes_max",
        "result_kind",
        "constraints",
        "guidance",
        "examples"
      ],
      "properties": {
        "availability": {"enum": ["available", "partially_described", "unavailable"]},
        "timeout_seconds_max": {"type": "integer", "minimum": 1, "maximum": 3600},
        "output_bytes_max": {"type": "integer", "minimum": 1, "maximum": 524288},
        "result_kind": {"const": "json"},
        "authority_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "approval_mode": {"enum": ["each_command", "session_start"]},
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "executable_aliases": {
              "type": "array",
              "maxItems": 64,
              "items": {"type": "string", "minLength": 1, "maxLength": 64}
            },
            "profile_aliases": {
              "type": "array",
              "maxItems": 32,
              "items": {"type": "string", "minLength": 1, "maxLength": 64}
            },
            "working_scopes": {
              "type": "array",
              "maxItems": 32,
              "items": {"type": "string", "minLength": 1, "maxLength": 64}
            },
            "environment_names": {
              "type": "array",
              "maxItems": 64,
              "items": {"type": "string", "minLength": 1, "maxLength": 64}
            }
          }
        },
        "guidance": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "examples": {
          "type": "array",
          "maxItems": 4,
          "items": {"type": "object"}
        }
      }
    }
  }
}
